<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400" width="400" height="400">
    <defs>
      <linearGradient id="grad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#18181B" />
        <stop offset="100%" stop-color="#27272A" />
      </linearGradient>
      <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
        <feDropShadow dx="0" dy="8" stdDeviation="12" flood-color="#000" flood-opacity="0.35"/>
      </filter>
    </defs>
    <rect width="400" height="400" rx="40" fill="url(#grad)" />
    <circle cx="200" cy="200" r="120" fill="white" fill-opacity="0.1" />
    <g filter="url(#shadow)" transform="translate(100, 100)">
      <rect x="35" y="35" width="130" height="130" rx="30" fill="none" stroke="#A855F7" stroke-width="12"/>
  <circle cx="100" cy="100" r="35" fill="#EC4899"/>
  <polygon points="100,80 115,110 85,110" fill="#FFFFFF"/>
    </g>
    <text x="200" y="340" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="22" font-weight="700" fill="#ffffff" text-anchor="middle" letter-spacing="1">
      Brand Vector Emblem
    </text>
  </svg>