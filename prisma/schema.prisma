generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  password         String
  name             String
  role             String            // REQUESTER | DESIGNER | APPROVER | ADMIN
  avatar           String?
  status           String            @default("ACTIVE") // ACTIVE | SUSPENDED
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  requesterProfile RequesterProfile?
  designerProfile  DesignerProfile?
  approverProfile  ApproverProfile?

  createdRequests  Requirement[]     @relation("RequesterRequirements")
  assignedRequests Requirement[]     @relation("DesignerRequirements")
  approvedRequests Requirement[]     @relation("ApproverRequirements")
  
  assignments      DesignerAssignment[]
  graphics         Graphic[]
  approvals        Approval[]
  revisions        Revision[]
  comments         Comment[]
  notifications    Notification[]
  activityLogs     ActivityLog[]
  sessions         Session[]
  cleanupReviews   GraphicsCleanupRequest[] @relation("CleanupReviewedBy")
  generatedCreatives GeneratedCreative[]
  creativeRequests CreativeRequest[]
  reportedIssues   SupportIssue[]           @relation("ReportedIssues")
  assignedIssues   SupportIssue[]           @relation("AssignedIssues")
  resolvedIssues   SupportIssue[]           @relation("ResolvedIssues")
  issueActivities  IssueActivity[]
}

model Session {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tabSessionId   String?
  sessionToken   String    @unique
  refreshToken   String?
  userAgent      String?
  ipAddress      String?
  deviceInfo     String?
  isRevoked      Boolean   @default(false)
  revokedAt      DateTime?
  lastActivityAt DateTime  @default(now())
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
  @@index([sessionToken])
  @@index([tabSessionId])
}

model RequesterProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberCode        String   @unique // e.g., "Member 01", "Member 02", ...
  department        String   @default("Marketing")
  phone             String?
  company           String?
  businessCategory  String?
  website           String?
  referralGroupName String?  @default("Apex Referral Chapter")
  birthDay          String?
  birthMonth        String?
  specificAsk       String?
}

model DesignerProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  designerCode   String   @unique // e.g., "Designer 01", "Designer 02", "Designer 03"
  specialty      String   @default("Social Media & Branding")
  activeCapacity Int      @default(5)
}

model ApproverProfile {
  id         String   @id @default(uuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String   @default("Creative Director & Brand Lead")
  department String   @default("Brand Governance")
}

model Requirement {
  id                     String            @id @default(uuid())
  reqCode                String            @unique // e.g. REQ-0001
  requesterId            String
  requester              User              @relation("RequesterRequirements", fields: [requesterId], references: [id])
  
  title                  String
  description            String
  category               String            @default("Social Media") // Social Media, Banner, Branding, Print, UI, Ad Creative
  platform               String            @default("Instagram")    // Instagram, Facebook, LinkedIn, Twitter, YouTube, Website, Print
  dimensions             String            @default("1080x1080")
  priority               String            @default("MEDIUM")       // LOW, MEDIUM, HIGH, URGENT
  deadline               DateTime
  status                 String            @default("PENDING")      
  // Workflow statuses: DRAFT, PENDING, ASSIGNED, IN_DESIGN, PENDING_APPROVAL, REVISION_REQUIRED, RESUBMITTED, FINAL_APPROVED, COMPLETED, REJECTED, CANCELLED
  
  additionalInstructions String?
  
  assignedDesignerId     String?
  assignedDesigner       User?             @relation("DesignerRequirements", fields: [assignedDesignerId], references: [id])
  
  approvedById           String?
  approvedBy             User?             @relation("ApproverRequirements", fields: [approvedById], references: [id])
  
  finalGraphicId         String?           @unique
  finalGraphic           Graphic?          @relation("FinalRequirementGraphic", fields: [finalGraphicId], references: [id])
  
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  files                  RequirementFile[]
  assignments            DesignerAssignment[]
  graphics               Graphic[]         @relation("RequirementGraphics")
  approvals              Approval[]
  revisions              Revision[]
  comments               Comment[]
  activityLogs           ActivityLog[]

  @@index([requesterId])
  @@index([assignedDesignerId])
  @@index([approvedById])
  @@index([status])
  @@index([createdAt])
  @@index([priority])
}

model RequirementFile {
  id            String      @id @default(uuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  fileName      String
  fileUrl       String
  fileType      String
  fileSize      Int
  isReference   Boolean     @default(true)
  uploadedAt    DateTime    @default(now())

  @@index([requirementId])
}

model DesignerAssignment {
  id            String      @id @default(uuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  designerId    String
  designer      User        @relation(fields: [designerId], references: [id])
  assignedAt    DateTime    @default(now())
  status        String      @default("ACTIVE") // ACTIVE, RELEASED, COMPLETED
  startedAt     DateTime?
  completedAt   DateTime?

  @@index([requirementId])
  @@index([designerId])
  @@index([status])
}

model Graphic {
  id                 String           @id @default(uuid())
  requirementId      String
  requirement        Requirement      @relation("RequirementGraphics", fields: [requirementId], references: [id], onDelete: Cascade)
  finalRequirement   Requirement?     @relation("FinalRequirementGraphic")
  designerId         String
  designer           User             @relation(fields: [designerId], references: [id])
  currentVersion     Int              @default(1)
  status             String           @default("PENDING_APPROVAL")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  versions           GraphicVersion[]

  @@index([requirementId])
  @@index([designerId])
  @@index([status])
}

model GraphicVersion {
  id             String      @id @default(uuid())
  graphicId      String
  graphic        Graphic     @relation(fields: [graphicId], references: [id], onDelete: Cascade)
  versionNumber  Int
  fileUrl        String
  previewUrl     String?
  fileName       String
  fileSize       Int
  mimeType       String
  dimensions     String?
  designerNotes  String?
  status         String      @default("PENDING_APPROVAL") // PENDING_APPROVAL, APPROVED, REVISION_REQUESTED, REJECTED
  createdAt      DateTime    @default(now())

  approvals      Approval[]
  revisions      Revision[]

  @@index([graphicId])
  @@index([status])
}

model Approval {
  id               String         @id @default(uuid())
  requirementId    String
  requirement      Requirement    @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  graphicVersionId String
  graphicVersion   GraphicVersion @relation(fields: [graphicVersionId], references: [id], onDelete: Cascade)
  approverId       String
  approver         User           @relation(fields: [approverId], references: [id])
  decision         String         // APPROVED | REVISION_REQUESTED | REJECTED
  comments         String?
  reviewedAt       DateTime       @default(now())

  @@index([requirementId])
  @@index([graphicVersionId])
  @@index([approverId])
}

model Revision {
  id               String         @id @default(uuid())
  requirementId    String
  requirement      Requirement    @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  graphicVersionId String
  graphicVersion   GraphicVersion @relation(fields: [graphicVersionId], references: [id], onDelete: Cascade)
  approverId       String
  approver         User           @relation(fields: [approverId], references: [id])
  revisionNumber   Int
  feedback         String
  requestedAt      DateTime       @default(now())
  isResolved       Boolean        @default(false)

  @@index([requirementId])
  @@index([graphicVersionId])
  @@index([approverId])
}

model Comment {
  id            String      @id @default(uuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  authorId      String
  author        User        @relation(fields: [authorId], references: [id])
  authorRole    String
  content       String
  isInternal    Boolean     @default(false)
  createdAt     DateTime    @default(now())

  @@index([requirementId])
  @@index([authorId])
}

model Notification {
  id                   String    @id @default(uuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                String
  message              String
  type                 String    // INFO | SUCCESS | WARNING | URGENT | SYSTEM | WORKFLOW | REQUIREMENT_CREATED | ASSIGNED | SUBMITTED | REVISION_REQUESTED | APPROVED | REJECTED
  priority             String    @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  actionUrl            String?
  actionLabel          String?
  entityType           String?   // REQUIREMENT | GRAPHIC | SYSTEM | USER
  entityId             String?
  relatedRequirementId String?
  isRead               Boolean   @default(false)
  readAt               DateTime?
  isDismissed          Boolean   @default(false)
  dismissedAt          DateTime?
  expiresAt            DateTime?
  createdAt            DateTime  @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([isDismissed])
}

model SystemNotice {
  id           String    @id @default(uuid())
  title        String
  message      String
  type         String    @default("SYSTEM") // INFO | SUCCESS | WARNING | URGENT | SYSTEM | WORKFLOW
  priority     String    @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  targetRole   String    @default("ALL")    // ALL | REQUESTER | DESIGNER | APPROVER | ADMIN
  targetUserId String?
  actionUrl    String?
  actionLabel  String?
  startAt      DateTime  @default(now())
  expiresAt    DateTime?
  isActive     Boolean   @default(true)
  createdBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([targetRole])
  @@index([isActive])
}

model ActivityLog {
  id            String       @id @default(uuid())
  requirementId String?
  requirement   Requirement? @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName      String
  userRole      String
  action        String
  details       String?
  timestamp     DateTime     @default(now())

  @@index([requirementId])
  @@index([userId])
  @@index([timestamp])
}


model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model GraphicsCleanupRequest {
  id                    String              @id @default(uuid())
  cycleNumber           Int                 @unique
  startDate             DateTime            @default(now())
  scheduledDeletionDate DateTime
  status                String              @default("COUNTDOWN_ACTIVE") // COUNTDOWN_ACTIVE | PENDING_APPROVAL | APPROVED | REJECTED | IN_PROGRESS | COMPLETED | FAILED
  graphicsCount         Int                 @default(0)
  totalSizeBytes        Float               @default(0)
  quarantineData        String?             @db.Text
  decisionNotes         String?             @db.Text
  reviewedById          String?
  reviewedBy            User?               @relation("CleanupReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt            DateTime?
  executedAt            DateTime?
  deletedCount          Int                 @default(0)
  failedCount           Int                 @default(0)
  logs                  String?             @db.Text
  deletedLogs           DeletedGraphicLog[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([status])
  @@index([scheduledDeletionDate])
}

model DeletedGraphicLog {
  id               String                 @id @default(uuid())
  cleanupRequestId String
  cleanupRequest   GraphicsCleanupRequest @relation(fields: [cleanupRequestId], references: [id], onDelete: Cascade)
  graphicId        String
  graphicVersionId String?
  requirementCode  String?
  fileName         String
  fileUrl          String
  fileSize         Int
  status           String                 // SUCCESS | FAILED
  errorMessage     String?
  deletedAt        DateTime               @default(now())

  @@index([cleanupRequestId])
  @@index([status])
}

model CreativeCategory {
  id          String   @id @default(uuid())
  code        String   @unique // MEETING_ANNOUNCEMENT | BUSINESS_PRESENTATION | KYM | BIRTHDAY
  name        String   // Referral Meeting Announcement, Business Presentation, Know Your Member (KYM), Birthday Creatives
  description String?
  icon        String?  // lucide icon identifier
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  templates   CreativeTemplate[]
  creatives   GeneratedCreative[]

  @@index([code])
  @@index([isActive])
}

model CreativeTemplate {
  id              String           @id @default(uuid())
  categoryId      String
  category        CreativeCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name            String           // e.g., "Minimal Corporate", "Premium White & Gold", "Modern Blue", "Elegant Dark", "Colorful Celebration"
  slug            String           @unique
  description     String?
  previewImageUrl String?
  backgroundUrl   String?
  baseDesignUrl   String?          // Custom uploaded base artwork URL
  width           Int              @default(1080)
  height          Int              @default(1080)
  orientation     String           @default("SQUARE") // SQUARE | PORTRAIT | LANDSCAPE
  themeStyle      String           @default("white-gold")
  logoPosition    String           @default("top-left") // top-left | top-center | top-right | bottom-left | bottom-center | bottom-right
  logoMaxWidth    Int              @default(200)
  logoMaxHeight   Int              @default(70)
  layoutVariant   String           @default("variant-1")
  status          String           @default("PUBLISHED") // DRAFT | PUBLISHED | INACTIVE
  approvalRequired Boolean         @default(false)
  placeholders    String           @db.Text // JSON configuration of placeholders & mappings
  stylingConfig   String?          @db.Text // JSON configuration of colors, typography, layout options
  isActive        Boolean          @default(true)
  isDefault       Boolean          @default(false)
  sortOrder       Int              @default(0)
  createdById     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  elements        TemplateElement[]
  creatives       GeneratedCreative[]
  creativeRequests CreativeRequest[]

  @@index([categoryId])
  @@index([status])
  @@index([isActive])
}

model BrandLogo {
  id          String   @id @default(uuid())
  name        String   // e.g. "Apex Referral Chapter", "Titans Executive Network", etc.
  slug        String   @unique
  logoUrl     String   // SVG or PNG url
  darkLogoUrl String?  // Optional inverted or light logo for dark templates
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creatives   GeneratedCreative[]

  @@index([isActive])
}

model GeneratedCreative {
  id                String            @id @default(uuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId        String
  category          CreativeCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  templateId        String?
  template          CreativeTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  logoId            String?
  logo              BrandLogo?        @relation(fields: [logoId], references: [id], onDelete: SetNull)
  logoUrl           String?
  title             String
  referralGroupName String?
  memberName        String?
  formData          String            @db.Text // JSON: all inputs
  fileUrl           String            // Downloadable file URL or data URI
  previewUrl        String?           // Thumbnail or preview image URL
  outputFormat      String            @default("PNG") // PNG | JPG | DOCX
  fileSize          Int               @default(0)
  dimensions        String?           // e.g. "1080x1080"
  downloadCount     Int               @default(0)
  lastDownloadedAt  DateTime?
  creativeRequest   CreativeRequest?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([userId])
  @@index([categoryId])
  @@index([templateId])
  @@index([logoId])
  @@index([createdAt])
}

model TemplateElement {
  id               String           @id @default(uuid())
  templateId       String
  template         CreativeTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  elementType      String           // LOGO | FIXED_TEXT | DYNAMIC_FIELD | MEMBER_PHOTO | COMPANY_LOGO | IMAGE
  fieldKey         String?          // e.g. memberName, companyName, mobileNumber, date, time, venue, specificAsk, dressCode, visitorFees, meetingStimulant
  name             String           // Human-readable label
  posX             Float            @default(0)
  posY             Float            @default(0)
  width            Float            @default(200)
  height           Float            @default(50)
  fontFamily       String           @default("Inter")
  fontSize         Float            @default(24)
  fontWeight       String           @default("normal")
  textColor        String           @default("#000000")
  textAlign        String           @default("left") // left | center | right
  lineSpacing      Float            @default(1.2)
  maxLines         Int              @default(1)
  overflowBehavior String           @default("wrap") // wrap | truncate | shrink
  zIndex           Int              @default(1)
  isLocked         Boolean          @default(false)
  isVisible        Boolean          @default(true)
  isRequired       Boolean          @default(true)
  defaultValue     String?
  styleConfig      String?          @db.Text // JSON extra styles (e.g. borderRadius, padding, textShadow, background)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([templateId])
  @@index([elementType])
}

model SharedFixedContent {
  id        String   @id @default(uuid())
  key       String   @unique // e.g. "global_footer", "global_sponsors", "global_leadership", "referral_group_name"
  label     String
  value     String   @db.Text // JSON or plain string
  scope     String   @default("GLOBAL") // GLOBAL | TEMPLATE
  updatedAt DateTime @updatedAt

  @@index([key])
}

model CreativeRequest {
  id                  String             @id @default(uuid())
  reqCode             String             @unique // e.g. CR-0001
  memberId            String
  member              User               @relation(fields: [memberId], references: [id], onDelete: Cascade)
  templateId          String
  template            CreativeTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  submittedData       String             @db.Text // JSON: all inputs from the form
  photoUrl            String?
  status              String             @default("PENDING_APPROVAL") // DRAFT | SUBMITTED | PENDING_APPROVAL | APPROVED | REJECTED | GENERATING | COMPLETED | FAILED
  adminFeedback       String?
  generatedCreativeId String?            @unique
  generatedCreative   GeneratedCreative? @relation(fields: [generatedCreativeId], references: [id], onDelete: SetNull)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([memberId])
  @@index([templateId])
  @@index([status])
  @@index([createdAt])
}

model SupportIssue {
  id                           String            @id @default(uuid())
  issueCode                    String            @unique // e.g. ISS-0001
  title                        String
  description                  String            @db.Text
  category                     String            @default("GENERAL") // CANVAS_STUDIO | TEMPLATE_EDITOR | DOWNLOAD_EXPORT | AUTH_LOGIN | UI_DISPLAY | GENERAL | OTHER
  priority                     String            @default("MEDIUM")  // LOW | MEDIUM | HIGH | URGENT
  status                       String            @default("OPEN")    // OPEN | IN_PROGRESS | RESOLVED | REOPENED | CLOSED
  affectedPage                 String?           // e.g. /requester/creative-studio
  reporterId                   String
  reporter                     User              @relation("ReportedIssues", fields: [reporterId], references: [id], onDelete: Cascade)
  assignedToId                 String?
  assignedTo                   User?             @relation("AssignedIssues", fields: [assignedToId], references: [id], onDelete: SetNull)
  resolvedById                 String?
  resolvedBy                   User?             @relation("ResolvedIssues", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt                   DateTime?
  resolutionSummary            String?           @db.Text
  previousResolutions          String?           @db.Text // JSON history of resolutions if reopened
  screenshotCleanupStatus      String            @default("NONE") // NONE | PENDING | COMPLETED | FAILED
  screenshotCleanupCompletedAt DateTime?
  screenshotCleanupError       String?           @db.Text
  deletedScreenshotCount       Int               @default(0)
  createdAt                    DateTime          @default(now())
  updatedAt                    DateTime          @updatedAt

  attachments                  IssueAttachment[]
  activities                   IssueActivity[]

  @@index([status])
  @@index([reporterId])
  @@index([resolvedById])
  @@index([createdAt])
  @@index([priority])
}

model IssueAttachment {
  id              String       @id @default(uuid())
  issueId         String
  issue           SupportIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  fileName        String
  fileUrl         String
  fileSize        Int          @default(0)
  mimeType        String       @default("image/png")
  isScreenshot    Boolean      @default(true)
  storageProvider String       @default("LOCAL") // LOCAL | S3 | CLOUDINARY
  uploadedAt      DateTime     @default(now())

  @@index([issueId])
  @@index([fileUrl])
}

model IssueActivity {
  id        String       @id @default(uuid())
  issueId   String
  issue     SupportIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName  String
  userRole  String
  action    String       // CREATED | STATUS_CHANGE | RESOLVED | REOPENED | CLEANUP_COMPLETED | CLEANUP_FAILED | COMMENT
  details   String?      @db.Text
  timestamp DateTime     @default(now())

  @@index([issueId])
  @@index([timestamp])
}


